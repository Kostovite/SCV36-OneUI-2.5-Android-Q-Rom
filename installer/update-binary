#!/sbin/sh
# TWRP installer for the SCV36 One UI 2 port update (built by tools/build/make_flashable_zip.sh).
# Flashes boot.img and replaces /system/vendor (except odm/) + /system additions, exactly like
# installer/twrp/twrp_vendor.ps1 does over adb. Needs the port's system already installed.
OUTFD=$2
ZIP=$3
ui_print() { echo "ui_print $1" >&$OUTFD; echo "ui_print" >&$OUTFD; }
abort() { ui_print "ERROR: $1"; exit 1; }

ui_print "SCV36 One UI 2 port update"
BL=$(getprop ro.boot.bootloader)
case "$BL" in SCV36*) ui_print "device: $BL" ;; *) abort "not an SCV36 (bootloader '$BL')" ;; esac

# work dir on /data (vendor.tar ~520 MB does not fit in TWRP's RAM /tmp)
mount /data 2>/dev/null
T=/data/media/0/s8port_zip
rm -rf $T; mkdir -p $T || abort "cannot create $T (is /data mounted / decrypted?)"
ui_print "extracting (vendor.tar takes a minute)..."
unzip -o "$ZIP" boot.img vendor.tar vendor_labels.sh apply_vendor.sh system_add.tar -d $T >/dev/null || abort "unzip failed"

ui_print "flashing boot.img"
dd if=$T/boot.img of=/dev/block/bootdevice/by-name/boot bs=4096 2>/dev/null && sync || abort "boot flash failed"

# apply_vendor.sh mounts the system block itself: release any TWRP mount of it first
umount /system_root 2>/dev/null; umount /system 2>/dev/null; umount /mnt/system 2>/dev/null
ui_print "installing vendor + system additions"
sh $T/apply_vendor.sh $T > $T/apply.log 2>&1
tail -n 25 $T/apply.log | while read -r l; do ui_print "  $l"; done
grep -q APPLY_OK $T/apply.log || abort "apply_vendor.sh failed (log: /sdcard/s8port_zip/apply.log)"

cp $T/apply.log /data/media/0/s8port_apply.log
rm -rf $T
ui_print "done - reboot to System (log: /sdcard/s8port_apply.log)"
exit 0
