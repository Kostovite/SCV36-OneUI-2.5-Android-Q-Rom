# Copy to config/local.env (ignored by git) and fill in. Sourced by tools/lib/env.sh.
# Build server for kernel builds (key-based ssh, see tools/setup/setup_server_ssh.sh)
BUILD_HOST=user@build-server
# Leave PHONE_PC empty when the phone is plugged into this machine (plain adb).
# Otherwise the PC the phone is on: adb runs there over ssh.
PHONE_PC=
#PHONE_PC=user@phone-pc
#PHONE_PC_TMP=C:/Users/user/AppData/Local/Temp
#PHONE_PC_PW=          # only if that PC has no ssh key set up (needs sshpass)
# Case-sensitive work dir (WSL ext4 / build server)
#S8ROM=$HOME/s8rom
